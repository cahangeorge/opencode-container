# OpenCode + OpenChamber Environment Variables
# Copy this file to ~/.config/opencode/.env and fill in your keys
# chmod 600 ~/.config/opencode/.env

# ─── LLM API Keys (at least one required) ──────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# ─── Search & Context MCPs ───────────────────────────────────────
BRAVE_API_KEY=...
CONTEXT7_API_KEY=...

# ─── AgentMemory (local context server) ─────────────────────────
AGENTMEMORY_URL=http://localhost:3111
AGENTMEMORY_SECRET=...

# ─── Playwriter (browser automation) ────────────────────────────
PLAYWRITER_TOKEN=...
PLAYWRITER_HOST=http://localhost:19988
PLAYWRITER_AUTO_ENABLE=1

# ─── OpenChamber Settings ──────────────────────────────────────
# UI password (optional, leave empty for no auth)
UI_PASSWORD=

# Enable OpenCode integration features
OH_MY_OPENCODE=true
OH_MY_OPENCODE_DCP=true

# GitHub integration
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# Tunnel settings (optional, for remote access)
# OPENCHAMBER_TUNNEL_PROVIDER=cloudflare
# OPENCHAMBER_TUNNEL_MODE=remote
# OPENCHAMBER_TUNNEL_HOSTNAME=your-domain.trycloudflare.com
# OPENCHAMBER_TUNNEL_TOKEN=...
# OPENCHAMBER_TUNNEL_CONFIG=
