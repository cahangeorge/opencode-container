# API Keys for OpenCode container
# Copy this to ~/.config/opencode/.env and fill in your keys
# These are passed into the container automatically

# LLM Providers (at least one required)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# MCP Servers
# CONTEXT7_API_KEY=
# BRAVE_API_KEY=

# Playwriter (if running on host)
# PLAYWRITER_HOST=http://localhost:19988

# AgentMemory (if running on host)
# AGENTMEMORY_URL=http://localhost:3111
